[Desktop Entry]
Type=Application
Name=Bordify App Launcher
Comment=Launch Windows applications via Wine or supported macOS apps via Darling
Exec=bordify-open %f
TryExec=bordify-open
Terminal=false
NoDisplay=false
Categories=System;Utility;
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/x-msi;application/x-apple-diskimage;
